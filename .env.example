# Lokale Testinstallation. Vor Start nach .env kopieren.
# Bestehendes Datenvolume: bisherige DB-Zugangsdaten beibehalten!
DATABASE_USER=kassensystem-test
DATABASE_PASSWORD=kassensystem-test
DATABASE_NAME=kassensystem-test
# Für lokale Python-Ausführung; Compose setzt intern postgres:5432.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DB_PORT_TEST=5434
APP_PORT_TEST=9690
APP_BIND_HOST=127.0.0.1
SECRET_KEY=your-secret-key-change-in-production
PRODUCTION=false
COOKIE_SECURE=false
TZ=Europe/Berlin
APP_TIMEZONE=Europe/Berlin
# Optional nur für lokale Ausführung: vollständige SQLAlchemy-URL.
# DATABASE_URL=postgresql+psycopg2://user:password@127.0.0.1:5434/database
